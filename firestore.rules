rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // users/{uid} — one profile doc per account, keyed by the Firebase Auth uid.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // games/{gameId}
    match /games/{gameId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.auth.uid in request.resource.data.player_ids;

      // Only status/completed_at may change (finishing a game); the roster and
      // metadata are fixed at creation time.
      allow update: if signedIn()
        && resource.data.status == 'in_progress'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'completed_at'])
        && request.resource.data.status == 'completed';

      allow delete: if false;

      // games/{gameId}/scores/{scoreId}
      match /scores/{scoreId} {
        allow read: if signedIn();

        allow create, update: if signedIn()
          && get(/databases/$(database)/documents/games/$(gameId)).data.status == 'in_progress'
          && request.resource.data.user_id in get(/databases/$(database)/documents/games/$(gameId)).data.player_ids
          && scoreId == (request.resource.data.user_id + '_' + string(request.resource.data.round_number));

        allow delete: if false;
      }
    }
  }
}
